{
  "name": "dsh-copilot-api",
  "version": "0.1.6",
  "description": "DeepSeek Harness provider for a copilot-api gateway",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caozhiyuan/dsh-copilot-api.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "copilot-api",
    "cordis"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README*.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@earendil-works/pi-ai": ">=0.87.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.6",
    "@deepseek-ai/cordis-plugin-timer": "1.1.7",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-resources": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-hmr": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "^0.28.2",
    "js-yaml": "4.3.2",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "npm run build && vitest run --config vitest.config.js",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.client.json"
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.2 <0.3.0"
  }
}
